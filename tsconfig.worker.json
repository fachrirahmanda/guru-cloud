{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["./src/worker/env.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "tsBuildInfoFile": "node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["src/worker", "src/shared", "vite.config.ts"]
}
