{
  "name": "cloud-open-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply cloud-open-code --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloud-open-code --remote",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types src/worker/env.d.ts --env-interface Env"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
